// Behaviors built from the ZMK defaults, each used across several layers. A
// behavior with machinery of its own belongs under features/.
//
// Label: the ZMK behavior it extends, abbreviated, matching upstream's label
// where there is one, or the domain name. Node: what the label stands for.

// -- Bindings -----------------------------------------------------------------

// Supply the parameters for a hold-tap whose binding ignores one of them.

#define HT_TR(KEY)   NA KEY
#define LT_CW(LAYER) LAYER NA

/ {
    behaviors {
        // -- Custom hold-tap --------------------------------------------------
        //
        // lt_d applies the defaults only; lt_qt adds a quick-tap window.
        //
        // ht_tr holds &trans to fall through to the layer below. A &trans
        // binding inside a hold-tap resolves to nothing, so the hold is inert
        // for now. Tracked as zmkfirmware/zmk#2368.

        ht_tr: HOLD_TAP(hold_tap_trans, <&trans>, <&kp>)

        lt_d:  HOLD_TAP(layer_tap_default,             <&mo>, <&kp>)
        lt_cw: HOLD_TAP(layer_tap_caps_word,           <&mo>, <&caps_word>)
        lt_qt: HOLD_TAP_QUICK_TAP(layer_tap_quick_tap, <&mo>, <&kp>)

        // -- Custom mod-morph -------------------------------------------------

        mm_arrows:       SHIFT_MORPH(mod_morph_arrows,       <&m_arrow_r>,       <&m_arrow_l>)
        mm_fat_arrows:   SHIFT_MORPH(mod_morph_fat_arrows,   <&m_fat_arrow_r>,   <&m_fat_arrow_l>)
        mm_tilde_arrows: SHIFT_MORPH(mod_morph_tilde_arrows, <&m_tilde_arrow_r>, <&m_tilde_arrow_l>)
        mm_pipes:        SHIFT_MORPH(mod_morph_pipes,        <&m_pipe_r>,        <&m_pipe_l>)
        mm_chevrons:     SHIFT_MORPH(mod_morph_chevrons,     <&m_ex_bitstring>,  <&m_chevrons>)
        mm_backticks:    SHIFT_MORPH(mod_morph_backticks,    <&m_backticks>,     <&m_triple_backticks>)
        mm_ex_specs:     SHIFT_MORPH(mod_morph_elixir_specs, <&m_ex_spec>,       <&m_ex_type>)

        // -- Custom sticky key ------------------------------------------------

        sk_qr: STICKY_KEY_QUICK_RELEASE(sticky_key_quick_release, <&kp>)
    };
};
